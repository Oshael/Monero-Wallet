{
  "name": "wallet-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=1 test/unit/*.test.ts test/quality/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run boundaries && npm run format:check && npm test",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
