+    MONERO_CHECK(check_delete_key(address, key));
+    return db->try_write([this, &address] (MDB_txn& txn) -> expect<crypto::hash>
+    {
+      const auto exists = has_registration(txn, db->tables, address);
+      if (!exists) return exists.error();
+      if (!*exists) return {lws::error::account_not_found};
+      cursor::outputs cur;
+      MONERO_CHECK(check_cursor(txn, db->tables.delete_tokens, cur));
+      const unsigned version = 1;
+      MDB_val k = lmdb::to_val(version), v = lmdb::to_val(address);
+      const int found = mdb_cursor_get(cur.get(), &k, &v, MDB_GET_BOTH);
+      if (!found)
+      {
+        const auto issued = delete_tokens.get_value<delete_token>(v);
+        if (!issued) return issued.error();
+        if (!same_address(issued->address, address)) return {lws::error::bad_view_key};
+        return issued->token;
+      }
+      if (found != MDB_NOTFOUND) return log_lmdb_error(found, __LINE__, __FILE__);
+      const delete_token issued{address, crypto::rand<crypto::hash>()};
+      v = lmdb::to_val(issued);
+      MLWS_LMDB_CHECK(mdb_cursor_put(cur.get(), &k, &v, MDB_NODUPDATA));
+      return issued.token;
+    });
+  }
