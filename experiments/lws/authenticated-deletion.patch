+  expect<bool> storage::delete_account(const account_address& address, const crypto::secret_key& key, const crypto::hash& token)
+  {
+    MONERO_CHECK(check_delete_key(address, key));
+    // Authentication, generation check, key removal and durable queue insertion
+    // are one writer transaction. A failed commit cannot report success.
+    const auto begun = db->try_write([this, &address, &token] (MDB_txn& txn) -> expect<void>
+    {
+      MDB_val k = lmdb::to_val(token), v{};
+      const int queued = mdb_get(&txn, db->tables.deletion_queue, &k, &v);
+      if (!queued)
+      {
+        const auto entry = deletion_queue.get_value<deletion_entry>(v);
+        if (!entry) return entry.error();
+        if (!same_address(entry->address, address)) return {lws::error::bad_view_key};
+        return success();
+      }
+      if (queued != MDB_NOTFOUND) return log_lmdb_error(queued, __LINE__, __FILE__);
+      cursor::outputs cur;
+      MONERO_CHECK(check_cursor(txn, db->tables.delete_tokens, cur));
+      const unsigned version = 1;
+      k = lmdb::to_val(version); v = lmdb::to_val(address);
+      const int found = mdb_cursor_get(cur.get(), &k, &v, MDB_GET_BOTH);
+      if (found == MDB_NOTFOUND)
+      {
+        const auto exists = has_registration(txn, db->tables, address);
+        if (!exists) return exists.error();
+        if (*exists) return {lws::error::bad_view_key};
+        k = lmdb::to_val(address.view_public);
+        const int pending = mdb_get(&txn, db->tables.deletions_by_address, &k, &v);
+        if (!pending) return {lws::error::bad_view_key};
+        if (pending != MDB_NOTFOUND) return log_lmdb_error(pending, __LINE__, __FILE__);
+        return success(); // absent with no pending data: authenticated retry
+      }
+      MLWS_LMDB_CHECK(found);
+      const auto issued = delete_tokens.get_value<delete_token>(v);
+      if (!issued) return issued.error();
+      if (!same_address(issued->address, address) || issued->token != token)
+        return {lws::error::bad_view_key};
+      MONERO_CHECK(unlink_registration(txn, db->tables, address, token));
+      MLWS_LMDB_CHECK(mdb_cursor_del(cur.get(), 0));
+      return success();
+    });
+    if (!begun) return begun.error();
+    return db->try_write([this, &token] (MDB_txn& txn) -> expect<bool>
+    {
+      return cleanup_one(txn, db->tables, token, 256);
+    });
+  }
+
+  expect<void> storage::cleanup_deleted_accounts()
+  {
+    return db->try_write([this] (MDB_txn& txn) -> expect<void>
+    {
+      cursor::outputs cur;
+      MONERO_CHECK(check_cursor(txn, db->tables.deletion_queue, cur));
+      MDB_val k{}, v{};
+      const int found = mdb_cursor_get(cur.get(), &k, &v, MDB_FIRST);
+      if (found == MDB_NOTFOUND) return success();
+      MLWS_LMDB_CHECK(found);
+      crypto::hash token{};
+      if (k.mv_size != sizeof(token)) return {lmdb::error(MDB_CORRUPTED)};
+      std::memcpy(&token, k.mv_data, sizeof(token));
+      const auto done = cleanup_one(txn, db->tables, token, 256);
+      if (!done) return done.error();
+      return success();
+    });
+  }
