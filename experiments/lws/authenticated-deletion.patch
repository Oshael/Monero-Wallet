+    // Each batch commits a bounded amount of work. A durable queue row remains
+    // until every index is gone, so restart resumes rather than acknowledging
+    // a partial cleanup as complete. No view key is stored in this queue.
+    template<typename K>
+    expect<bool> erase_batch(MDB_txn& txn, MDB_dbi table, const K& owner, std::size_t& budget)
+    {
+      cursor::outputs cur;
+      MONERO_CHECK(check_cursor(txn, table, cur));
+      MDB_val key = lmdb::to_val(owner), value{};
+      for (;;)
+      {
+        key = lmdb::to_val(owner);
+        const int found = mdb_cursor_get(cur.get(), &key, &value, MDB_SET_KEY);
+        if (found == MDB_NOTFOUND) return true;
+        MLWS_LMDB_CHECK(found);
+        if (!budget) return false;
+        MLWS_LMDB_CHECK(mdb_cursor_del(cur.get(), 0));
+        --budget;
+      }
+    }
+
+    expect<bool> erase_spends_batch(MDB_txn& txn, const storage_internal::tables_& tables, account_id id, std::size_t& budget)
+    {
+      cursor::spends cur;
+      cursor::images image_cur;
+      MONERO_CHECK(check_cursor(txn, tables.spends, cur));
+      MONERO_CHECK(check_cursor(txn, tables.images, image_cur));
+      MDB_val key = lmdb::to_val(id), value{};
+      for (;;)
+      {
+        key = lmdb::to_val(id);
+        const int found = mdb_cursor_get(cur.get(), &key, &value, MDB_SET_KEY);
+        if (found == MDB_NOTFOUND) return true;
+        MLWS_LMDB_CHECK(found);
+        if (!budget) return false;
+        const auto entry = spends.get_value<spend>(value);
+        if (!entry) return entry.error();
+        MONERO_CHECK(remove_image_reference(*image_cur, id, *entry));
+        MLWS_LMDB_CHECK(mdb_cursor_del(cur.get(), 0));
+        --budget;
+      }
+    }
+
+    expect<bool> cleanup_one(MDB_txn& txn, const storage_internal::tables_& tables, const crypto::hash& token, std::size_t budget)
+    {
+      MDB_val queue_key = lmdb::to_val(token), queue_value{};
+      const int found = mdb_get(&txn, tables.deletion_queue, &queue_key, &queue_value);
+      if (found == MDB_NOTFOUND) return true;
+      MLWS_LMDB_CHECK(found);
+      const auto queued = deletion_queue.get_value<deletion_entry>(queue_value);
+      if (!queued) return queued.error();
+      const auto spent = erase_spends_batch(txn, tables, queued->id, budget);
+      if (!spent || !*spent) return spent;
+      for (const auto table : {tables.outputs, tables.events, tables.subaddress_ranges, tables.subaddress_indexes})
+      {
+        const auto done = erase_batch(txn, table, queued->id, budget);
+        if (!done || !*done) return done;
+      }
+      for (const auto type : {webhook_type::tx_confirmation, webhook_type::new_account, webhook_type::tx_spend})
+      {
+        const webhook_key hook{queued->id, type, {0, 0, 0}};
+        const auto done = erase_batch(txn, tables.webhooks, hook, budget);
+        if (!done || !*done) return done;
+      }
+      MDB_val address_key = lmdb::to_val(queued->address.view_public);
+      MDB_val address_value = lmdb::to_val(token);
+      MLWS_LMDB_CHECK(mdb_del(&txn, tables.deletions_by_address, &address_key, &address_value));
+      MLWS_LMDB_CHECK(mdb_del(&txn, tables.deletion_queue, &queue_key, nullptr));
+      return true;
+    }
