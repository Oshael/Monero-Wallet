+  /** Import bounded LWS results; ownership and commitments are checked natively. */
+  async importLightWalletData(json: string): Promise<void> {
+    if (this.getWalletProxy()) return this.getWalletProxy().importLightWalletData(json);
+    return this.module.queueTask(async () => {
+      this.assertNotClosed();
+      return new Promise<void>((resolve, reject) => {
+        this.module.import_light_wallet_data(this.cppAddress, json, (error) => {
+          if (typeof error === "string") reject(new MoneroError(error));
+          else resolve();
+        });
+      });
+    });
+  }
+
+  /** Restore only the scan height accompanying a validated encrypted light cache. */
+  async restoreLightWalletHeight(height: number): Promise<void> {
+    if (!Number.isSafeInteger(height) || height <= 0 || height > 1000000000) throw new MoneroError("Invalid light wallet height");
+    if (this.getWalletProxy()) return this.getWalletProxy().restoreLightWalletHeight(height);
+    return this.module.queueTask(async () => {
+      this.assertNotClosed();
+      return new Promise<void>((resolve, reject) => {
+        this.module.restore_light_wallet_height(this.cppAddress, height, (error) => {
+          if (typeof error === "string") reject(new MoneroError(error));
+          else resolve();
+        });
+      });
+    });
+  }
