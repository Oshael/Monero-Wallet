+bool http_client_wasm::set_server(const std::string& address, boost::optional<login> user, ssl_options_t ssl_options) {
+  // Keep the selected endpoint path on this client, including after reconnection.
+  url_content parsed{};
+  if (!parse_url(address, parsed) || !parsed.m_uri_content.m_query.empty() ||
+      !parsed.m_uri_content.m_fragment.empty()) return false;
+  if (!abstract_http_client::set_server(address, std::move(user), std::move(ssl_options))) return false;
+  m_path_prefix = std::move(parsed.m_uri_content.m_path);
+  while (!m_path_prefix.empty() && m_path_prefix.back() == '/') m_path_prefix.pop_back();
+  return true;
+}
